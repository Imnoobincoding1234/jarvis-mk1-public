# JARVIS MK-1 — environment template.
#
# The REAL values live in private/vault.enc, not here. Restore them with:
#     ./tools/vault.sh unpack
# This file exists so a machine without the vault passphrase can still be brought up by hand, and
# so the shape of the config is reviewable in a diff without exposing a single key.
#
# Read fresh on every request, so edits apply without a restart.

# ── Primary LLM: OpenRouter (optional — empty means local-only, which is the
#    current running configuration on the 8 GB M1) ──────────────────────────
OPENROUTER_API_KEY=
JARVIS_CHAT_MODEL=

# ── Local model via Ollama. install.sh pulls whatever is named here. ────────
JARVIS_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
JARVIS_LOCAL_URL=http://127.0.0.1:11434
# Context window. Measured flat at 8192/4096/2048 on this hardware — GQA means the weights, not the
# KV cache, dominate, so there is nothing to win by shrinking it.
JARVIS_LOCAL_CTX=8192

# ── Vision model (camera + screenshot analysis; REQUIRED for screen control) ─
JARVIS_VISION_MODEL=qwen3-vl:2b

# ── Cloud lane (optional) ──────────────────────────────────────────────────
COMPOSIO_API_KEY=

# ── Voice (local neural TTS via piper) ─────────────────────────────────────
#    Unset behaves as JARVIS_TTS=piper. Set it to `off` or `browser` to go back
#    to the macOS Web Speech voice (Daniel), which is also the automatic
#    fallback whenever piper is missing or a line fails to synthesise.
#    Install lives OUTSIDE the repo so nothing here needs node_modules:
#      python3 -m venv ~/.local/share/piper-jarvis/venv
#      ~/.local/share/piper-jarvis/venv/bin/pip install piper-tts
#      ~/.local/share/piper-jarvis/venv/bin/python -m piper.download_voices \
#         en_GB-semaine-medium --data-dir ~/.local/share/piper-jarvis/voices
#    SPEAKER only means anything on a multi-speaker model; en_GB-semaine has
#    four and 2 is obadiah, the deep measured one he picked by ear.
#    LENGTH_SCALE is phoneme duration, so HIGHER IS SLOWER — the unhurried
#    cadence is most of what separates a butler from a screen reader.
JARVIS_TTS=piper
JARVIS_TTS_MODEL=en_GB-semaine-medium
JARVIS_TTS_SPEAKER=2
JARVIS_TTS_LENGTH_SCALE=1.1
# JARVIS_PIPER_ROOT=/Users/you/.local/share/piper-jarvis
# JARVIS_PIPER_PYTHON=   # defaults to <root>/venv/bin/python
# JARVIS_PIPER_VOICES=   # defaults to <root>/voices

# ── Misc ───────────────────────────────────────────────────────────────────
JARVIS_SOCIAL_INSTAGRAM=
JARVIS_TAILNET=

# ── Deliberately unset. JARVIS_SOS_LIVE arms real emergency dialling; it must
#    stay unset unless the owner says otherwise, and must never be tested live. ─
# JARVIS_SOS_LIVE=

# ── reasoning ──────────────────────────────────────────────────────────────
# A SECOND LOCAL MODEL, used only for questions that need working out. Measured
# on an 8 GB M-series Air: qwen2.5:3b scored 5/15 on arithmetic/time/unit word
# problems, phi4-mini scored 11/15. Leave BLANK to keep everything on the one
# chat model — nothing breaks, reasoning answers are just worse.
#
# install.sh pulls whatever is named here. If you set it by hand, pull it too:
#   ollama pull phi4-mini
# JARVIS is defensive about this anyway: a model named here but not installed is
# detected at first use and reasoning quietly stays on the chat model.
JARVIS_REASONING_MODEL=phi4-mini:latest

# THE CHAT-REPLY MODEL (plain chat only, plus the Wikipedia lane for questions webintent sends to the web).
# jarvis = PrismML's Bonsai 4B (1-bit) + the v4.2 LoRA trained in finetune/ (runs/bonsai_v42_verdict.md). Build it
# once, on Ollama <= 0.33.x (0.34.1 removed adapter creation):
#   ollama pull hf.co/prism-ml/Bonsai-4B-gguf:Q1_0
#   cd finetune && ./.venv/bin/python export_lora_gguf.py adapters/bonsai_v42_s1/0000690_adapters.safetensors \
#       adapters/bonsai_v42_s1/adapter_config.json adapters/bonsai_v42_s1/jarvis-v42-lora.gguf
#   ollama create jarvis -f Modelfile.jarvis
# Leave BLANK to answer chat with JARVIS_LOCAL_MODEL as before (the Wikipedia lane is then skipped).
JARVIS_CHAT_REPLY_MODEL=jarvis

# THE EMBEDDERS. nomic-embed-text reads English and has been the default for every
# classifier since 2026-09-12 (81 held-out routing goals: 74 right and 0 wrong,
# against all-minilm's 68 and 7). granite-embedding:278m reads romanized Hinglish, and it
# exists because an English model does not merely read Hinglish BADLY — it leaks.
# Measured on sixteen romanized phrasings, all-minilm routed three private
# questions to a search engine: "mere bhai ka naam kya hai" (what is my brother's
# name), "mujhe kal kya karna hai", "mere contacts dikhao". granite routes none of
# them there: highest wrong margin 0.000 against all-minilm's 0.040.
#
# They are NOT interchangeable — every threshold was swept for the model it runs
# under, and a threshold swept for one stops firing under another. all-minilm is
# still needed too: six readers pin it on measurement (errand, actread, calintent,
# itemclass, replyclaim, replyhedge), and install.sh always pulls it.
#
# intent.js and recall.js read these two from the PROCESS environment (the launchd
# agent), not from this file. install.sh reads the ALT one here to decide what to
# pull, and always pulls nomic-embed-text and all-minilm. The first line used to
# say all-minilm, which described a default that ended on 2026-09-12. Change
# either only after re-sweeping every gate.
JARVIS_EMBED_MODEL=nomic-embed-text
JARVIS_EMBED_MODEL_ALT=granite-embedding:278m

# THE READER MODEL (jarvis-os/readmodel.js). Built by install.sh from the vault's
# adapter, never pulled. Read from the PROCESS environment, so these are written
# down here rather than set — the defaults are the measured values:
#   JARVIS_READER_MODEL=jarvis-reader
#   JARVIS_READER_MIN_CONFIDENCE=0.75     below this it asks "Should I …?"
#   JARVIS_READER_ASK_FLOOR=0.3           below this it does nothing
#   JARVIS_READER_POLARITY_MIN=0.5        open/close, create/delete: the model's own
#   JARVIS_READER_POLARITY_MARGIN=0.5     probability, and its lead over the other half
# The reader stays loaded 2 minutes after a read and the embedders 60 seconds. Longer
# was tried and reverted: on 8 GB with a browser open it made everything slower.

# How long the reasoning model stays resident after answering. This is a MEMORY
# setting, not a speed one: on 8 GB the two models cannot both be loaded (3.7 GB
# + 2.4 GB starves the machine and Ollama stops generating), so JARVIS evicts one
# to load the other. A longer value makes a run of reasoning questions faster; a
# shorter one returns the memory sooner. 0s unloads immediately.
JARVIS_REASONING_KEEPALIVE=90s
